# API PostgreSQL (use the same DB variables as the existing server).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sddb
DB_USER=sierra_admin
DB_PASSWORD=

# Generate a random value of at least 32 characters. Do not use the login password.
MENU_JWT_SECRET=
# Only needed while running menu:setup -- --admin; remove afterward.
MENU_ADMIN_EMAIL=
MENU_ADMIN_PASSWORD=

# Build-time configuration: keep this public URL forever after printing the QR.
VITE_BASE_PATH=/
VITE_GASTROBAR_MENU_URL=https://gastro.sierradorada.co
